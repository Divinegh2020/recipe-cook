# Site
NEXT_PUBLIC_SITE_NAME=Recipe Cook
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only admin key (NEVER expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# Admin access - comma-separated Supabase-authenticated emails
ADMIN_EMAILS=you@example.com

# Bachs payments
BACHS_API_KEY=sk_sandbox_your_key_here
BACHS_WEBHOOK_SECRET=whsec_your_secret_here
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_CURRENCY=USD

# Optional: email delivery provider can be added later